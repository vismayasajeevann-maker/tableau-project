      <aliases enabled='yes' />
      <column caption='Profit' datatype='real' name='[Calculation_1710887342317568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([gross]) AND NOT ISNULL([budget])&#13;&#10;THEN [gross] - [budget]&#13;&#10;END' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_1710887344619521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([gross])&#13;&#10;AND NOT ISNULL([budget])&#13;&#10;AND [gross] &lt;&gt; 0&#13;&#10;THEN&#13;&#10;    ([gross] - [budget]) / [gross]&#13;&#10;END' />
      </column>
